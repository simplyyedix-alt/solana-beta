{
  "name": "solara-bay",
  "version": "1.0.0",
  "description": "Solara Bay - original open-world PC game prototype",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "npm run preview --prefix client",
    "test": "npm run test:client",
    "test:client": "npm test --prefix client"
  },
  "keywords": ["game", "open-world", "pc", "prototype"],
  "author": "simplyyedix-alt",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
